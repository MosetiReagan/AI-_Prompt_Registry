{
  "name": "@ai-prompt-registry/sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for AI Prompt Registry",
  "author": {
    "name": "Reagan Moseti",
    "url": "https://www.linkedin.com/in/reagan-moseti-1a8380238/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
