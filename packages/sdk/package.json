  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-prompt-registry/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2"
  }
}
